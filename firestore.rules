rules_version = '2';

// Security rules for the Szabo Family Wishlists site.
// Paste this whole file into Firebase console > Firestore Database > Rules > Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // The 4 family accounts. Keep in sync with FAMILY in config.js.
    function isFamily() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() in [
          'kitteny99@gmail.com',
          'zabe73@gmail.com',
          'teri444@citlink.net',
          'suzanne.szabo.9@gmail.com'
        ];
    }

    // Signed in as a family member AND this is their own uid.
    function isMe(uid) { return isFamily() && request.auth.uid == uid; }

    function str(d, key, max) {
      return !(key in d) || (d[key] is string && d[key].size() <= max);
    }

    function validItem() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'category', 'url', 'price', 'priority', 'notes',
                               'thumb', 'imageId', 'imageShared', 'order',
                               'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.category in ['want', 'need', 'activity']
        && str(d, 'url', 1000) && str(d, 'price', 20) && str(d, 'notes', 1000)
        && str(d, 'thumb', 80000) && str(d, 'imageId', 40)
        && d.order is number;
    }

    // Name, sizes and favorites: anyone reads, only you write yours.
    match /people/{uid} {
      allow read: if true;
      allow write: if isMe(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
    }

    match /years/{year} {
      allow read: if true;
      allow create, update: if isFamily();

      // One list per person per year.
      match /lists/{uid} {
        allow read: if true;
        allow write: if isMe(uid);

        match /items/{itemId} {
          allow read: if true;
          allow create, update: if isMe(uid) && validItem();
          allow delete: if isMe(uid);
        }
      }

      // "I'm getting this" claims. The list owner can never read, make or
      // remove claims on their own list, so their surprises stay hidden.
      match /claims/{itemId} {
        allow read: if signedIn() && resource.data.listUid != request.auth.uid;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['listUid', 'claimerUid', 'name', 'at'])
          && request.resource.data.claimerUid == request.auth.uid
          && request.resource.data.listUid != request.auth.uid
          && str(request.resource.data, 'name', 40)
          && exists(/databases/$(database)/documents/years/$(year)/lists/$(request.resource.data.listUid)/items/$(itemId));
        allow delete: if signedIn() && resource.data.listUid != request.auth.uid;
        allow update: if false;
      }
    }

    // Full-size photos (already shrunk on the phone to well under 1 MB).
    match /images/{imageId} {
      allow read: if true;
      allow create: if isFamily()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 900000;
      allow delete: if isFamily() && resource.data.owner == request.auth.uid;
      allow update: if false;
    }

    // Lists from the original site: kept as a read-only archive.
    match /christmasLists/{id} {
      allow read: if true;
      allow write: if false;
    }
  }
}
